<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mango.ui.CatalogoController" styleClass="tela">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="MANGO" styleClass="marca"/>
            <TextField fx:id="txtBusca" promptText="Buscar por título (mín. 2 caracteres)…"
                       onAction="#buscar" prefWidth="320"/>
            <ComboBox fx:id="cmbGenero" promptText="Gênero" prefWidth="180"/>
            <Button fx:id="btnBuscar" text="Buscar" onAction="#buscar" defaultButton="true"/>
            <Label fx:id="lblStatus" styleClass="status"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="rolagem">
                <TilePane fx:id="grade" hgap="18" vgap="22" prefColumns="5">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                </TilePane>
            </ScrollPane>
            <ProgressIndicator fx:id="progresso" visible="false"
                               maxWidth="64" maxHeight="64"/>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="14" alignment="CENTER" styleClass="barra">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Button fx:id="btnAnterior" text="← Anterior" onAction="#paginaAnterior" disable="true"/>
            <Label fx:id="lblPagina"/>
            <Button fx:id="btnProxima" text="Próxima →" onAction="#proximaPagina" disable="true"/>
        </HBox>
    </bottom>
</BorderPane>
