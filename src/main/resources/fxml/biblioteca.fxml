<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mango.ui.BibliotecaController" styleClass="tela">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="barra">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="← Voltar" onAction="#voltar"/>
            <Label text="Minha Biblioteca" styleClass="titulo-ficha"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nova lista" onAction="#novaLista"/>
            <Button fx:id="btnRemover" text="Remover lista" onAction="#removerLista"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6" prefWidth="220" minWidth="200" styleClass="lateral">
            <padding><Insets top="14" right="10" bottom="14" left="10"/></padding>
            <Button text="Início" maxWidth="200" onAction="#irInicio" styleClass="nav-item"/>
            <Button text="Favoritos" maxWidth="200" onAction="#irFavoritos" styleClass="nav-item"/>
            <Button text="Histórico" maxWidth="200" onAction="#irHistorico" styleClass="nav-item"/>
            <Label text="MINHAS LISTAS" styleClass="nav-secao"/>
            <ListView fx:id="listaColecoes" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="8">
            <padding><Insets top="12" right="6" bottom="6" left="12"/></padding>
            <Label fx:id="lblSecao" styleClass="titulo-ficha"/>
            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" styleClass="rolagem">
                    <TilePane fx:id="grade" hgap="18" vgap="22" prefColumns="5">
                        <padding><Insets top="8" right="20" bottom="20" left="8"/></padding>
                    </TilePane>
                </ScrollPane>
                <Label fx:id="lblVazio" styleClass="status"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
