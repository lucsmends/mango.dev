<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mango.ui.RelatorioController" styleClass="tela">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="barra">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Button text="← Voltar" onAction="#voltar"/>
            <Label text="Relatórios de leitura" styleClass="titulo-leitor"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Período:" styleClass="status"/>
            <ComboBox fx:id="cmbPeriodo" prefWidth="170"/>
            <Button fx:id="btnExportar" text="Exportar CSV" onAction="#exportar"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="rolagem">
                <VBox fx:id="conteudo" spacing="16">
                    <padding><Insets top="16" right="20" bottom="20" left="20"/></padding>
                </VBox>
            </ScrollPane>
            <ProgressIndicator fx:id="progresso" visible="false" maxWidth="64" maxHeight="64"/>
        </StackPane>
    </center>
</BorderPane>
