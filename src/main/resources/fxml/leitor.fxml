<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mango.ui.LeitorController" fx:id="raiz"
            styleClass="tela,leitor" focusTraversable="true">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="barra">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Button text="← Voltar" onAction="#voltar"/>
            <Label fx:id="lblTitulo" styleClass="titulo-leitor"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnModo" text="Modo: Página" onAction="#alternarModo"/>
            <Label fx:id="lblAviso" styleClass="aviso"/>
            <Label fx:id="lblPagina" styleClass="status"/>
            <TextField fx:id="txtIrPara" promptText="Ir para…" prefWidth="80"
                       onAction="#irPara"/>
            <Button text="−" onAction="#zoomMenos"/>
            <Label fx:id="lblZoom" text="100%" styleClass="status"/>
            <Button text="+" onAction="#zoomMais"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fx:id="rolagem" fitToWidth="true" pannable="true"
                        styleClass="rolagem-leitor">
                <VBox fx:id="conteudo" alignment="TOP_CENTER" spacing="2"
                      styleClass="painel-leitor"/>
            </ScrollPane>

            <VBox fx:id="painelErro" visible="false" spacing="14"
                  alignment="CENTER" maxWidth="420" maxHeight="160"
                  styleClass="painel-erro">
                <Label fx:id="lblErro" wrapText="true" textAlignment="CENTER"/>
                <Button text="Tentar novamente" onAction="#tentarNovamente"/>
            </VBox>

            <ProgressIndicator fx:id="progresso" visible="false"
                               maxWidth="64" maxHeight="64"/>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="14" alignment="CENTER" styleClass="barra">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <Button fx:id="btnAnterior" text="← Anterior" onAction="#anterior"/>
            <Button fx:id="btnProxima" text="Próxima →" onAction="#proxima"/>
        </HBox>
    </bottom>
</BorderPane>
