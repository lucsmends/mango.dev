<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mango.controller.LeitorController" styleClass="leitor-root">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra-superior">
            <Button text="Voltar" onAction="#onVoltar"/>
            <Label fx:id="lblTitulo" styleClass="leitor-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="-" onAction="#onZoomOut"/>
            <Label fx:id="lblZoom" text="100%" styleClass="status"/>
            <Button text="+" onAction="#onZoomIn"/>
            <Label fx:id="lblInfo" styleClass="status"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="scroll" styleClass="leitor-area" pannable="true">
            <content>
                <StackPane fx:id="painel" styleClass="leitor-painel">
                    <ImageView fx:id="imgPagina" preserveRatio="true"/>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="24" alignment="CENTER" styleClass="leitor-controles">
            <Button fx:id="btnPagAnterior" text="◀ Anterior" onAction="#onPaginaAnterior"/>
            <Button fx:id="btnPagProxima" text="Proxima ▶" onAction="#onPaginaProxima"/>
        </HBox>
    </bottom>

</BorderPane>
