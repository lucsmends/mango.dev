@@ -0,0 +1,84 @@
+package com.mango.repository;
+
+import com.mango.model.ProgressoLeitura;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.Optional;
+import java.util.Properties;
+
+public final class FileProgressoLeituraRepository implements ProgressoLeituraRepository {
+    private final Path arquivo;
+
+    public FileProgressoLeituraRepository(final Path arquivo) {
+        this.arquivo = arquivo;
+    }
+
+    @Override
+    public synchronized Optional<ProgressoLeitura> buscarPorCapitulo(final String capituloId) {
+        final Properties properties = carregarProperties();
+        final String valor = properties.getProperty(capituloId);
+        if (valor == null || valor.isBlank()) {
+            return Optional.empty();
+        }
+
+        final String[] partes = valor.split("\\|");
+        if (partes.length != 4) {
+            return Optional.empty();
+        }
+
+        try {
+            return Optional.of(new ProgressoLeitura(
+                    capituloId,
+                    Integer.parseInt(partes[0]),
+                    Integer.parseInt(partes[1]),
+                    Boolean.parseBoolean(partes[2]),
+                    Instant.parse(partes[3])
+            ));
+        } catch (final RuntimeException exception) {
+            return Optional.empty();
+        }
+    }
+
+    @Override
+    public synchronized void salvar(final ProgressoLeitura progresso) {
+        final Properties properties = carregarProperties();
+        properties.setProperty(
+                progresso.capituloId(),
+                progresso.paginaAtual()
+                        + "|" + progresso.totalPaginas()
+                        + "|" + progresso.concluido()
+                        + "|" + progresso.atualizadoEm()
+        );
+        persistirProperties(properties);
+    }
+
+    private Properties carregarProperties() {
+        final Properties properties = new Properties();
+        if (!Files.exists(arquivo)) {
+            return properties;
+        }
+
+        try (InputStream inputStream = Files.newInputStream(arquivo)) {
+            properties.load(inputStream);
+            return properties;
+        } catch (final IOException exception) {
+            throw new IllegalStateException("Não foi possível carregar o progresso de leitura.", exception);
+        }
+    }
+
+    private void persistirProperties(final Properties properties) {
+        try {
+            Files.createDirectories(arquivo.getParent());
+            try (OutputStream outputStream = Files.newOutputStream(arquivo)) {
+                properties.store(outputStream, "Mango - progresso de leitura");
+            }
+        } catch (final IOException exception) {
+            throw new IllegalStateException("Não foi possível salvar o progresso de leitura.", exception);
+        }
+    }
+}
