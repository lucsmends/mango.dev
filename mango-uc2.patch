+package com.mango.model;
+
+import java.util.Objects;
+
+public final class SessaoLeitura {
+    private final CapituloLeitura capitulo;
+    private ModoLeitura modoLeitura;
+    private int paginaAtualIndex;
+    private double zoom;
+    private boolean concluido;
+
+    public SessaoLeitura(
+            final CapituloLeitura capitulo,
+            final ModoLeitura modoLeitura,
+            final int paginaAtualIndex
+    ) {
+        this.capitulo = Objects.requireNonNull(capitulo, "capitulo");
+        this.modoLeitura = modoLeitura == null ? capitulo.modoPadrao() : modoLeitura;
+        this.paginaAtualIndex = paginaAtualIndex;
+        this.zoom = 1.0;
+        this.concluido = false;
+    }
+
+    public CapituloLeitura capitulo() {
+        return capitulo;
+    }
+
+    public synchronized ModoLeitura modoLeitura() {
+        return modoLeitura;
+    }
+
+    public synchronized void alterarModoLeitura(final ModoLeitura modoLeitura) {
+        this.modoLeitura = modoLeitura == null ? ModoLeitura.PAGINA_UNICA : modoLeitura;
+    }
+
+    public synchronized int paginaAtualIndex() {
+        return paginaAtualIndex;
+    }
+
+    public synchronized int paginaAtual() {
+        return paginaAtualIndex + 1;
+    }
+
+    public int totalPaginas() {
+        return capitulo.totalPaginas();
+    }
+
+    public synchronized void alterarPaginaAtualIndex(final int paginaAtualIndex) {
+        this.paginaAtualIndex = paginaAtualIndex;
+        this.concluido = paginaAtualIndex == totalPaginas() - 1;
+    }
+
+    public synchronized double zoom() {
+        return zoom;
+    }
+
+    public synchronized void alterarZoom(final double zoom) {
+        this.zoom = zoom;
+    }
+
+    public synchronized boolean concluido() {
+        return concluido;
+    }
+}
