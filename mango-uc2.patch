+package com.mango.config;
+
+import com.mango.integration.mangadex.MangaDexChapterPageProvider;
+import com.mango.repository.FileProgressoLeituraRepository;
+import com.mango.repository.ProgressoLeituraRepository;
+import com.mango.service.ChapterPageProvider;
+import com.mango.service.LeituraService;
+import com.mango.service.PageCacheService;
+
+public final class LeituraModuleFactory {
+    private LeituraModuleFactory() {
+    }
+
+    public static LeituraService criarPadrao() {
+        final ChapterPageProvider pageProvider = new MangaDexChapterPageProvider(false);
+        final PageCacheService pageCacheService = new PageCacheService(AppPaths.cachePaginas(), pageProvider);
+        final ProgressoLeituraRepository progressoRepository = new FileProgressoLeituraRepository(AppPaths.progressoLeitura());
+        return new LeituraService(pageProvider, pageCacheService, progressoRepository);
+    }
+}
diff --git a/src/main/java/com/mango/controller/LeitorCapituloController.java b/src/main/java/com/mango/controller/LeitorCapituloController.java
