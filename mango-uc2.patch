diff --git a/src/main/java/com/mango/service/LeituraService.java b/src/main/java/com/mango/service/LeituraService.java
new file mode 100644
index 0000000..5aa62b2
--- /dev/null
+++ b/src/main/java/com/mango/service/LeituraService.java
@@ -0,0 +1,184 @@
+package com.mango.service;
+
+import com.mango.model.CapituloLeitura;
+import com.mango.model.ModoLeitura;
+import com.mango.model.ProgressoLeitura;
+import com.mango.model.SessaoLeitura;
+import com.mango.repository.ProgressoLeituraRepository;
+
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+
+public final class LeituraService {
+    public static final double ZOOM_MINIMO = 0.25;
+    public static final double ZOOM_MAXIMO = 4.00;
+    public static final double ZOOM_PADRAO = 1.00;
+
+    private final ChapterPageProvider pageProvider;
+    private final PageCacheService pageCacheService;
+    private final ProgressoLeituraRepository progressoRepository;
+
+    public LeituraService(
+            final ChapterPageProvider pageProvider,
+            final PageCacheService pageCacheService,
+            final ProgressoLeituraRepository progressoRepository
+    ) {
+        this.pageProvider = Objects.requireNonNull(pageProvider, "pageProvider");
+        this.pageCacheService = Objects.requireNonNull(pageCacheService, "pageCacheService");
+        this.progressoRepository = Objects.requireNonNull(progressoRepository, "progressoRepository");
+    }
+
+    public CompletableFuture<SessaoLeitura> abrirCapitulo(
+            final String capituloId,
+            final ModoLeitura modoPreferido
+    ) {
+        if (capituloId == null || capituloId.isBlank()) {
+            return CompletableFuture.failedFuture(new IllegalArgumentException("O id do capítulo é obrigatório."));
+        }
+
+        return pageProvider.listarUrlsPaginas(capituloId)
+                .thenApply(urls -> criarSessao(capituloId, modoPreferido, urls))
+                .thenApply(sessao -> {
+                    carregarPaginaAtual(sessao);
+                    pageCacheService.preCarregarProximas(sessao);
+                    return sessao;
+                });
+    }
+
+    public CompletableFuture<Path> paginaAtualArquivo(final SessaoLeitura sessao) {
+        return carregarPaginaAtual(sessao);
+    }
+
+    public CompletableFuture<Path> arquivoDaPagina(
+            final SessaoLeitura sessao,
+            final int paginaUmBased
+    ) {
+        final int indice = validarPagina(sessao, paginaUmBased);
+        return pageCacheService.carregarPagina(
+                sessao.capitulo().id(),
+                indice,
+                sessao.capitulo().paginaPorIndice(indice)
+        );
+    }
+
+    public CompletableFuture<Path> proximaPagina(final SessaoLeitura sessao) {
+        if (sessao.paginaAtual() >= sessao.totalPaginas()) {
+            return paginaAtualArquivo(sessao);
+        }
+        return irParaPagina(sessao, sessao.paginaAtual() + 1);
+    }
+
+    public CompletableFuture<Path> paginaAnterior(final SessaoLeitura sessao) {
+        if (sessao.paginaAtual() <= 1) {
+            return paginaAtualArquivo(sessao);
+        }
+        return irParaPagina(sessao, sessao.paginaAtual() - 1);
+    }
+
+    public CompletableFuture<Path> irParaPagina(
+            final SessaoLeitura sessao,
+            final int paginaUmBased
+    ) {
+        final int indice = validarPagina(sessao, paginaUmBased);
+        sessao.alterarPaginaAtualIndex(indice);
+        registrarProgresso(sessao);
+        pageCacheService.preCarregarProximas(sessao);
+        return carregarPaginaAtual(sessao);
+    }
+
+    public CompletableFuture<Path> tentarNovamentePaginaAtual(final SessaoLeitura sessao) {
+        final int indice = sessao.paginaAtualIndex();
+        return pageCacheService.recarregarPagina(
+                sessao.capitulo().id(),
+                indice,
+                sessao.capitulo().paginaPorIndice(indice)
+        );
+    }
+
+    public void alterarModo(final SessaoLeitura sessao, final ModoLeitura modoLeitura) {
+        sessao.alterarModoLeitura(modoLeitura);
+    }
+
+    public double alterarZoom(final SessaoLeitura sessao, final double zoomSolicitado) {
+        final double zoomLimitado = limitarZoom(zoomSolicitado);
+        sessao.alterarZoom(zoomLimitado);
+        return zoomLimitado;
+    }
+
+    public double incrementarZoom(final SessaoLeitura sessao, final double delta) {
+        return alterarZoom(sessao, sessao.zoom() + delta);
+    }
+
+    public ModoLeitura modoPadraoPorOrigem(final String idiomaOriginal) {
+        if (idiomaOriginal == null) {
+            return ModoLeitura.PAGINA_UNICA;
+        }
+        final String idioma = idiomaOriginal.toLowerCase(Locale.ROOT).strip();
+        return idioma.equals("ko") || idioma.equals("kor") || idioma.equals("coreano")
+                ? ModoLeitura.SCROLL_VERTICAL
+                : ModoLeitura.PAGINA_UNICA;
+    }
+
+    private SessaoLeitura criarSessao(
+            final String capituloId,
+            final ModoLeitura modoPreferido,
+            final List<java.net.URI> urls
+    ) {
+        if (urls == null || urls.isEmpty()) {
+            throw new CapituloSemPaginasException();
+        }
+
+        final CapituloLeitura capitulo = new CapituloLeitura(
+                capituloId,
+                null,
+                "Capítulo " + capituloId,
+                urls,
+                modoPreferido == null ? ModoLeitura.PAGINA_UNICA : modoPreferido
+        );
+
+        final int paginaInicial = progressoRepository.buscarPorCapitulo(capituloId)
+                .filter(progresso -> progresso.totalPaginas() == capitulo.totalPaginas())
+                .map(ProgressoLeitura::paginaAtual)
+                .orElse(1);
+
+        return new SessaoLeitura(capitulo, capitulo.modoPadrao(), paginaInicial - 1);
+    }
+
+    private CompletableFuture<Path> carregarPaginaAtual(final SessaoLeitura sessao) {
+        final int indice = sessao.paginaAtualIndex();
+        return pageCacheService.carregarPagina(
+                sessao.capitulo().id(),
+                indice,
+                sessao.capitulo().paginaPorIndice(indice)
+        );
+    }
+
+    private int validarPagina(final SessaoLeitura sessao, final int paginaUmBased) {
+        Objects.requireNonNull(sessao, "sessao");
+        if (paginaUmBased < 1 || paginaUmBased > sessao.totalPaginas()) {
+            throw new PaginaInvalidaException(sessao.totalPaginas());
+        }
+        return paginaUmBased - 1;
+    }
+
+    private void registrarProgresso(final SessaoLeitura sessao) {
+        progressoRepository.salvar(new ProgressoLeitura(
+                sessao.capitulo().id(),
+                sessao.paginaAtual(),
+                sessao.totalPaginas(),
+                sessao.paginaAtual() == sessao.totalPaginas(),
+                Instant.now()
+        ));
+    }
+
+    private double limitarZoom(final double zoomSolicitado) {
+        if (Double.isNaN(zoomSolicitado) || Double.isInfinite(zoomSolicitado)) {
+            return ZOOM_PADRAO;
+        }
+        return Math.max(ZOOM_MINIMO, Math.min(ZOOM_MAXIMO, zoomSolicitado));
+    }
+}
