+package com.mango.view;
+
+import com.mango.config.LeituraModuleFactory;
+import com.mango.controller.LeitorCapituloController;
+import com.mango.model.ModoLeitura;
+
+import javafx.fxml.FXMLLoader;
+import javafx.scene.Parent;
+import javafx.scene.Scene;
+import javafx.stage.Stage;
+
+import java.io.IOException;
+import java.util.Objects;
+
+/**
+ * Ponto único para abrir o leitor de capítulos a partir de qualquer controller.
+ *
+ * Quando o UC1 estiver pronto, basta chamar:
+ * LeitorCapituloLauncher.abrir(capituloId);
+ */
+public final class LeitorCapituloLauncher {
+    private static final String FXML_LEITOR = "/fxml/leitor-capitulo.fxml";
+
+    private LeitorCapituloLauncher() {
+    }
+
+    public static void abrir(final String capituloId) {
+        abrir(capituloId, ModoLeitura.PAGINA_UNICA);
+    }
+
+    public static void abrir(final String capituloId, final ModoLeitura modoInicial) {
+        final Stage stage = new Stage();
+        abrirNoStage(stage, capituloId, modoInicial);
+    }
+
+    public static void abrirNoStage(
+            final Stage stage,
+            final String capituloId,
+            final ModoLeitura modoInicial
+    ) {
+        Objects.requireNonNull(stage, "stage");
+
+        try {
+            final FXMLLoader loader = new FXMLLoader(Objects.requireNonNull(
+                    LeitorCapituloLauncher.class.getResource(FXML_LEITOR),
+                    "FXML do leitor não encontrado: " + FXML_LEITOR
+            ));
+
+            final Parent root = loader.load();
+            final LeitorCapituloController controller = loader.getController();
+            controller.setLeituraService(LeituraModuleFactory.criarPadrao());
+
+            stage.setTitle("Mango - Leitor de Capítulos");
+            stage.setScene(new Scene(root, 1200, 850));
+            stage.show();
+
+            if (capituloId != null && !capituloId.isBlank()) {
+                controller.abrirCapitulo(capituloId.strip(), modoInicial);
+            }
+        } catch (final IOException exception) {
+            throw new IllegalStateException("Não foi possível abrir o leitor de capítulos.", exception);
+        }
+    }
+}
