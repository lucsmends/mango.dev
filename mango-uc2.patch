+package com.mango.model;
+
+import java.time.Instant;
+
+public record ProgressoLeitura(
+        String capituloId,
+        int paginaAtual,
+        int totalPaginas,
+        boolean concluido,
+        Instant atualizadoEm
+) {
+    public ProgressoLeitura {
+        if (capituloId == null || capituloId.isBlank()) {
+            throw new IllegalArgumentException("O id do capítulo é obrigatório.");
+        }
+        if (totalPaginas <= 0) {
+            throw new IllegalArgumentException("O total de páginas deve ser maior que zero.");
+        }
+        if (paginaAtual < 1 || paginaAtual > totalPaginas) {
+            throw new IllegalArgumentException("A página atual deve estar entre 1 e " + totalPaginas + ".");
+        }
+        atualizadoEm = atualizadoEm == null ? Instant.now() : atualizadoEm;
+    }
+
+    public static ProgressoLeitura emAndamento(
+            final String capituloId,
+            final int paginaAtual,
+            final int totalPaginas
+    ) {
+        return new ProgressoLeitura(
+                capituloId,
+                paginaAtual,
+                totalPaginas,
+                paginaAtual == totalPaginas,
+                Instant.now()
+        );
+    }
+}
