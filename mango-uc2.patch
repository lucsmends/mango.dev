+package com.mango.integration.mangadex;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.mango.service.ChapterPageProvider;
+import com.mango.service.FalhaDownloadPaginaException;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+
+public final class MangaDexChapterPageProvider implements ChapterPageProvider {
+    private static final URI DEFAULT_API_BASE_URI = URI.create("https://api.mangadex.org");
+
+    private final HttpClient httpClient;
+    private final ObjectMapper objectMapper;
+    private final URI apiBaseUri;
+    private final boolean usarDataSaver;
+
+    public MangaDexChapterPageProvider() {
+        this(HttpClient.newHttpClient(), new ObjectMapper(), DEFAULT_API_BASE_URI, false);
+    }
+
+    public MangaDexChapterPageProvider(final boolean usarDataSaver) {
+        this(HttpClient.newHttpClient(), new ObjectMapper(), DEFAULT_API_BASE_URI, usarDataSaver);
+    }
+
+    public MangaDexChapterPageProvider(
+            final HttpClient httpClient,
+            final ObjectMapper objectMapper,
+            final URI apiBaseUri,
+            final boolean usarDataSaver
+    ) {
+        this.httpClient = Objects.requireNonNull(httpClient, "httpClient");
+        this.objectMapper = Objects.requireNonNull(objectMapper, "objectMapper");
+        this.apiBaseUri = Objects.requireNonNull(apiBaseUri, "apiBaseUri");
+        this.usarDataSaver = usarDataSaver;
+    }
+
+    @Override
+    public CompletableFuture<List<URI>> listarUrlsPaginas(final String capituloId) {
+        final String idCodificado = URLEncoder.encode(capituloId, StandardCharsets.UTF_8);
+        final URI endpoint = apiBaseUri.resolve("/at-home/server/" + idCodificado);
+        final HttpRequest request = HttpRequest.newBuilder(endpoint)
+                .GET()
+                .timeout(Duration.ofSeconds(15))
+                .header("Accept", "application/json")
+                .build();
+
+        return httpClient.sendAsync(request, HttpResponse.BodyHandlers.ofString())
+                .thenApply(this::validarRespostaJson)
+                .thenApply(this::extrairUrlsPaginas);
+    }
+
+    @Override
+    public CompletableFuture<byte[]> baixarPagina(final URI paginaUri) {
+        final HttpRequest request = HttpRequest.newBuilder(paginaUri)
+                .GET()
+                .timeout(Duration.ofSeconds(30))
+                .header("User-Agent", "Mango-Academic-Reader/1.0")
+                .build();
+
+        return httpClient.sendAsync(request, HttpResponse.BodyHandlers.ofByteArray())
+                .thenApply(response -> {
+                    if (response.statusCode() < 200 || response.statusCode() >= 300) {
+                        throw new FalhaDownloadPaginaException(
+                                "Não foi possível baixar a página. HTTP " + response.statusCode() + "."
+                        );
+                    }
+                    return response.body();
+                });
+    }
+
+    private String validarRespostaJson(final HttpResponse<String> response) {
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new FalhaDownloadPaginaException(
+                    "Não foi possível obter as páginas do capítulo. HTTP " + response.statusCode() + "."
+            );
+        }
+        return response.body();
+    }
+
+    private List<URI> extrairUrlsPaginas(final String json) {
+        try {
+            final JsonNode root = objectMapper.readTree(json);
+            final String baseUrl = root.path("baseUrl").asText(null);
+            final JsonNode chapter = root.path("chapter");
+            final String hash = chapter.path("hash").asText(null);
+            final JsonNode paginas = usarDataSaver ? chapter.path("dataSaver") : chapter.path("data");
+            final String modo = usarDataSaver ? "data-saver" : "data";
+
+            if (baseUrl == null || hash == null || !paginas.isArray()) {
+                throw new FalhaDownloadPaginaException("Resposta inválida da API MangaDex para as páginas do capítulo.");
+            }
+
+            final List<URI> urls = new ArrayList<>();
+            for (final JsonNode pagina : paginas) {
+                final String nomeArquivo = pagina.asText();
+                urls.add(URI.create(baseUrl + "/" + modo + "/" + hash + "/" + nomeArquivo));
+            }
+            return List.copyOf(urls);
+        } catch (final IOException exception) {
+            throw new FalhaDownloadPaginaException("Não foi possível interpretar a resposta da API MangaDex.", exception);
+        }
+    }
+}
