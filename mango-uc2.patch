diff --git a/src/test/java/com/mango/service/LeituraServiceTest.java b/src/test/java/com/mango/service/LeituraServiceTest.java
new file mode 100644
index 0000000..8f5d2c7
--- /dev/null
+++ b/src/test/java/com/mango/service/LeituraServiceTest.java
@@ -0,0 +1,134 @@
+package com.mango.service;
+
+import com.mango.model.ModoLeitura;
+import com.mango.model.ProgressoLeitura;
+import com.mango.model.SessaoLeitura;
+import com.mango.repository.InMemoryProgressoLeituraRepository;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class LeituraServiceTest {
+    @TempDir
+    Path tempDir;
+
+    private InMemoryProgressoLeituraRepository progressoRepository;
+
+    @BeforeEach
+    void setUp() {
+        progressoRepository = new InMemoryProgressoLeituraRepository();
+    }
+
+    @Test
+    void abrirCapituloSemPaginasRetornaErro() {
+        final LeituraService service = criarService(List.of());
+
+        final CompletionException exception = assertThrows(
+                CompletionException.class,
+                () -> service.abrirCapitulo("capitulo-sem-paginas", ModoLeitura.PAGINA_UNICA).join()
+        );
+
+        assertInstanceOf(CapituloSemPaginasException.class, exception.getCause());
+    }
+
+    @Test
+    void navegarParaProximaPaginaRegistraProgressoContinuo() {
+        final LeituraService service = criarService(paginas(3));
+        final SessaoLeitura sessao = service.abrirCapitulo("capitulo-1", ModoLeitura.PAGINA_UNICA).join();
+
+        service.proximaPagina(sessao).join();
+
+        final Optional<ProgressoLeitura> progresso = progressoRepository.buscarPorCapitulo("capitulo-1");
+        assertTrue(progresso.isPresent());
+        assertEquals(2, progresso.get().paginaAtual());
+        assertEquals(3, progresso.get().totalPaginas());
+        assertEquals(false, progresso.get().concluido());
+    }
+
+    @Test
+    void chegarNaUltimaPaginaMarcaCapituloComoLido() {
+        final LeituraService service = criarService(paginas(2));
+        final SessaoLeitura sessao = service.abrirCapitulo("capitulo-2", ModoLeitura.PAGINA_UNICA).join();
+
+        service.proximaPagina(sessao).join();
+
+        final ProgressoLeitura progresso = progressoRepository.buscarPorCapitulo("capitulo-2").orElseThrow();
+        assertEquals(2, progresso.paginaAtual());
+        assertTrue(progresso.concluido());
+    }
+
+    @Test
+    void irParaPaginaForaDoIntervaloBloqueiaOperacao() {
+        final LeituraService service = criarService(paginas(4));
+        final SessaoLeitura sessao = service.abrirCapitulo("capitulo-3", ModoLeitura.PAGINA_UNICA).join();
+
+        final PaginaInvalidaException exception = assertThrows(
+                PaginaInvalidaException.class,
+                () -> service.irParaPagina(sessao, 99)
+        );
+
+        assertEquals("Página inválida. Informe um número entre 1 e 4.", exception.getMessage());
+    }
+
+    @Test
+    void zoomRespeitaLimitesDaRegraDeNegocio() {
+        final LeituraService service = criarService(paginas(1));
+        final SessaoLeitura sessao = service.abrirCapitulo("capitulo-4", ModoLeitura.PAGINA_UNICA).join();
+
