@@ -0,0 +1,377 @@
+package com.mango.controller;
+
+import com.mango.model.ModoLeitura;
+import com.mango.model.SessaoLeitura;
+import com.mango.service.LeituraService;
+
+import javafx.application.Platform;
+import javafx.fxml.FXML;
+import javafx.scene.Scene;
+import javafx.scene.control.Button;
+import javafx.scene.control.ComboBox;
+import javafx.scene.control.Label;
+import javafx.scene.control.Slider;
+import javafx.scene.control.TextField;
+import javafx.scene.image.Image;
+import javafx.scene.image.ImageView;
+import javafx.scene.input.KeyCode;
+import javafx.scene.input.KeyEvent;
+import javafx.scene.layout.BorderPane;
+import javafx.scene.layout.HBox;
+import javafx.scene.layout.StackPane;
+import javafx.scene.layout.VBox;
+import javafx.scene.control.ScrollPane;
+import javafx.stage.Stage;
+
+import java.nio.file.Path;
+import java.util.Objects;
+import java.util.concurrent.CompletionException;
+
+public final class LeitorCapituloController {
+    @FXML private BorderPane root;
+    @FXML private ComboBox<ModoLeitura> modoComboBox;
+    @FXML private Label progressoLabel;
+    @FXML private Label statusLabel;
+    @FXML private TextField irParaField;
+    @FXML private TextField chapterIdField;
+    @FXML private Slider zoomSlider;
+    @FXML private Button tentarNovamenteButton;
+    @FXML private StackPane paginaUnicaContainer;
+    @FXML private HBox paginaDuplaContainer;
+    @FXML private ScrollPane scrollPane;
+    @FXML private VBox scrollContent;
+    @FXML private ImageView paginaUnicaImage;
+    @FXML private ImageView paginaEsquerdaImage;
+    @FXML private ImageView paginaDireitaImage;
+
+    private LeituraService leituraService;
+    private SessaoLeitura sessao;
+    private boolean atualizandoScrollInternamente;
+
+    public void setLeituraService(final LeituraService leituraService) {
+        this.leituraService = Objects.requireNonNull(leituraService, "leituraService");
+    }
+
+    public void abrirCapitulo(final String capituloId, final ModoLeitura modoInicial) {
+        validarServiceConfigurado();
+        if (capituloId == null || capituloId.isBlank()) {
+            mostrarStatus("Informe o ID do capítulo para abrir o leitor.");
+            return;
+        }
+        chapterIdField.setText(capituloId.strip());
+        mostrarStatus("Carregando capítulo...");
+
+        leituraService.abrirCapitulo(capituloId, modoInicial)
+                .whenComplete((novaSessao, error) -> Platform.runLater(() -> {
+                    if (error != null) {
+                        mostrarErro(error);
+                        return;
+                    }
+                    this.sessao = novaSessao;
+                    modoComboBox.setValue(novaSessao.modoLeitura());
+                    zoomSlider.setValue(novaSessao.zoom() * 100.0);
+                    renderizar();
+                    mostrarStatus("Capítulo aberto.");
+                }));
+    }
+
+    @FXML
+    private void initialize() {
+        modoComboBox.getItems().setAll(ModoLeitura.values());
+        modoComboBox.setOnAction(event -> alterarModo());
+
+        zoomSlider.setMin(25);
+        zoomSlider.setMax(400);
+        zoomSlider.setValue(100);
+        zoomSlider.valueProperty().addListener((observable, oldValue, newValue) -> {
+            if (sessao == null) {
+                return;
+            }
+            leituraService.alterarZoom(sessao, newValue.doubleValue() / 100.0);
+            aplicarZoom();
+        });
+
+        scrollPane.vvalueProperty().addListener((observable, oldValue, newValue) -> atualizarProgressoPorScroll());
+        tentarNovamenteButton.setVisible(false);
+        tentarNovamenteButton.setManaged(false);
+
+        root.sceneProperty().addListener((observable, oldScene, newScene) -> configurarAtalhos(newScene));
+    }
+
+
+    @FXML
+    private void abrirCapituloInformado() {
+        if (chapterIdField == null) {
+            return;
+        }
+
+        final String capituloId = chapterIdField.getText() == null
+                ? ""
+                : chapterIdField.getText().strip();
+
+        if (capituloId.isBlank()) {
+            mostrarStatus("Cole o ID do capítulo do MangaDex antes de abrir.");
+            return;
+        }
+
+        final ModoLeitura modoInicial = modoComboBox.getValue() == null
+                ? ModoLeitura.PAGINA_UNICA
+                : modoComboBox.getValue();
+
+        abrirCapitulo(capituloId, modoInicial);
+    }
+
+    @FXML
+    private void proximaPagina() {
+        if (sessao == null) {
+            return;
+        }
+        leituraService.proximaPagina(sessao)
+                .whenComplete((path, error) -> Platform.runLater(() -> finalizarNavegacao(error)));
+    }
+
+    @FXML
+    private void paginaAnterior() {
+        if (sessao == null) {
+            return;
+        }
+        leituraService.paginaAnterior(sessao)
+                .whenComplete((path, error) -> Platform.runLater(() -> finalizarNavegacao(error)));
+    }
+
+    @FXML
+    private void irParaPagina() {
+        if (sessao == null) {
+            return;
+        }
+
+        try {
+            final int pagina = Integer.parseInt(irParaField.getText().strip());
+            leituraService.irParaPagina(sessao, pagina)
+                    .whenComplete((path, error) -> Platform.runLater(() -> finalizarNavegacao(error)));
+        } catch (final NumberFormatException exception) {
+            mostrarStatus("Informe um número de página válido.");
+        }
+    }
+
+    @FXML
+    private void tentarNovamentePaginaAtual() {
+        if (sessao == null) {
+            return;
+        }
+        mostrarStatus("Tentando baixar a página novamente...");
+        leituraService.tentarNovamentePaginaAtual(sessao)
+                .whenComplete((path, error) -> Platform.runLater(() -> finalizarNavegacao(error)));
+    }
+
+    private void alterarModo() {
+        if (sessao == null || modoComboBox.getValue() == null) {
+            return;
+        }
+        leituraService.alterarModo(sessao, modoComboBox.getValue());
+        renderizar();
+    }
+
+    private void configurarAtalhos(final Scene scene) {
+        if (scene == null) {
+            return;
+        }
+        scene.addEventFilter(KeyEvent.KEY_PRESSED, event -> {
+            if (event.getCode() == KeyCode.RIGHT || event.getCode() == KeyCode.SPACE) {
+                proximaPagina();
+                event.consume();
+            } else if (event.getCode() == KeyCode.LEFT) {
+                paginaAnterior();
+                event.consume();
+            } else if (event.getCode() == KeyCode.ADD || event.getCode() == KeyCode.PLUS || event.getCode() == KeyCode.EQUALS) {
+                zoomSlider.setValue(Math.min(400, zoomSlider.getValue() + 25));
+                event.consume();
+            } else if (event.getCode() == KeyCode.SUBTRACT || event.getCode() == KeyCode.MINUS) {
+                zoomSlider.setValue(Math.max(25, zoomSlider.getValue() - 25));
+                event.consume();
+            } else if (event.getCode() == KeyCode.F11) {
+                alternarTelaCheia();
+                event.consume();
+            } else if (event.getCode() == KeyCode.ESCAPE) {
+                fecharJanela();
+                event.consume();
+            }
+        });
+    }
+
+    private void renderizar() {
+        if (sessao == null) {
+            return;
+        }
+
+        atualizarIndicadores();
+        aplicarVisibilidadeModo(sessao.modoLeitura());
+        tentarNovamenteButton.setVisible(false);
+        tentarNovamenteButton.setManaged(false);
+
+        switch (sessao.modoLeitura()) {
+            case PAGINA_UNICA -> renderizarPaginaUnica();
+            case PAGINA_DUPLA -> renderizarPaginaDupla();
+            case SCROLL_VERTICAL -> renderizarScrollVertical();
+        }
+        aplicarZoom();
+    }
+
+    private void renderizarPaginaUnica() {
+        carregarImagem(sessao.paginaAtualIndex(), paginaUnicaImage);
+    }
+
+    private void renderizarPaginaDupla() {
+        final int primeiraPagina = sessao.paginaAtualIndex();
+        carregarImagem(primeiraPagina, paginaEsquerdaImage);
+
+        final int segundaPagina = primeiraPagina == 0 ? -1 : primeiraPagina + 1;
+        if (segundaPagina >= 0 && segundaPagina < sessao.totalPaginas()) {
+            paginaDireitaImage.setVisible(true);
+            paginaDireitaImage.setManaged(true);
+            carregarImagem(segundaPagina, paginaDireitaImage);
+        } else {
+            paginaDireitaImage.setImage(null);
+            paginaDireitaImage.setVisible(false);
+            paginaDireitaImage.setManaged(false);
+        }
+    }
+
+    private void renderizarScrollVertical() {
+        atualizandoScrollInternamente = true;
+        scrollContent.getChildren().clear();
+        for (int index = 0; index < sessao.totalPaginas(); index++) {
+            final ImageView imageView = criarImageViewPadrao();
+            scrollContent.getChildren().add(imageView);
+            carregarImagem(index, imageView);
+        }
+        aplicarZoom();
+        Platform.runLater(() -> {
+            if (sessao.totalPaginas() > 1) {
+                scrollPane.setVvalue((double) sessao.paginaAtualIndex() / (sessao.totalPaginas() - 1));
+            } else {
+                scrollPane.setVvalue(0);
+            }
+            atualizandoScrollInternamente = false;
+        });
+    }
+
+    private ImageView criarImageViewPadrao() {
+        final ImageView imageView = new ImageView();
+        imageView.setPreserveRatio(true);
+        imageView.setSmooth(true);
+        imageView.setFitWidth(900);
+        return imageView;
+    }
+
+    private void carregarImagem(final int paginaIndexZeroBased, final ImageView imageView) {
+        leituraService.arquivoDaPagina(sessao, paginaIndexZeroBased + 1)
+                .whenComplete((path, error) -> Platform.runLater(() -> {
+                    if (error != null) {
+                        imageView.setImage(null);
+                        mostrarPlaceholderDeErro(error);
+                        return;
+                    }
+                    exibirImagem(path, imageView);
+                }));
+    }
+
+    private void exibirImagem(final Path path, final ImageView imageView) {
+        imageView.setImage(new Image(path.toUri().toString(), true));
+        mostrarStatus("Página " + sessao.paginaAtual() + " de " + sessao.totalPaginas());
+    }
+
+    private void finalizarNavegacao(final Throwable error) {
+        if (error != null) {
+            mostrarErro(error);
+            return;
+        }
+        renderizar();
+    }
+
+    private void aplicarVisibilidadeModo(final ModoLeitura modoLeitura) {
+        final boolean paginaUnica = modoLeitura == ModoLeitura.PAGINA_UNICA;
+        final boolean paginaDupla = modoLeitura == ModoLeitura.PAGINA_DUPLA;
+        final boolean scrollVertical = modoLeitura == ModoLeitura.SCROLL_VERTICAL;
+
+        paginaUnicaContainer.setVisible(paginaUnica);
+        paginaUnicaContainer.setManaged(paginaUnica);
+        paginaDuplaContainer.setVisible(paginaDupla);
+        paginaDuplaContainer.setManaged(paginaDupla);
+        scrollPane.setVisible(scrollVertical);
+        scrollPane.setManaged(scrollVertical);
+    }
+
+    private void aplicarZoom() {
+        if (sessao == null) {
+            return;
+        }
+        final double zoom = sessao.zoom();
+        paginaUnicaImage.setScaleX(zoom);
+        paginaUnicaImage.setScaleY(zoom);
+        paginaEsquerdaImage.setScaleX(zoom);
+        paginaEsquerdaImage.setScaleY(zoom);
+        paginaDireitaImage.setScaleX(zoom);
+        paginaDireitaImage.setScaleY(zoom);
+        scrollContent.getChildren().forEach(node -> {
+            node.setScaleX(zoom);
+            node.setScaleY(zoom);
+        });
+    }
+
+    private void atualizarIndicadores() {
+        progressoLabel.setText("Página " + sessao.paginaAtual() + " / " + sessao.totalPaginas());
+        irParaField.setPromptText("1-" + sessao.totalPaginas());
+        if (sessao.concluido()) {
+            mostrarStatus("Capítulo marcado como lido.");
+        }
+    }
+
+    private void atualizarProgressoPorScroll() {
+        if (sessao == null || sessao.modoLeitura() != ModoLeitura.SCROLL_VERTICAL || atualizandoScrollInternamente) {
+            return;
+        }
+        if (sessao.totalPaginas() <= 1) {
+            return;
+        }
+
+        final int paginaCalculada = (int) Math.round(scrollPane.getVvalue() * (sessao.totalPaginas() - 1)) + 1;
+        if (paginaCalculada != sessao.paginaAtual()) {
+            leituraService.irParaPagina(sessao, paginaCalculada);
+            atualizarIndicadores();
+        }
+    }
+
+    private void mostrarPlaceholderDeErro(final Throwable error) {
+        mostrarErro(error);
+        tentarNovamenteButton.setVisible(true);
+        tentarNovamenteButton.setManaged(true);
+    }
+
+    private void mostrarErro(final Throwable error) {
+        final Throwable causa = error instanceof CompletionException && error.getCause() != null
+                ? error.getCause()
+                : error;
+        mostrarStatus(causa.getMessage() == null ? "Falha inesperada no leitor." : causa.getMessage());
+    }
+
+    private void mostrarStatus(final String mensagem) {
+        statusLabel.setText(mensagem);
+    }
+
+    private void validarServiceConfigurado() {
+        if (leituraService == null) {
+            throw new IllegalStateException("LeituraService não foi configurado no controller.");
+        }
+    }
+
+    private void alternarTelaCheia() {
+        final Stage stage = (Stage) root.getScene().getWindow();
+        stage.setFullScreen(!stage.isFullScreen());
+    }
+
+    private void fecharJanela() {
+        final Stage stage = (Stage) root.getScene().getWindow();
+        stage.close();
+    }
+}
