@@ -0,0 +1,62 @@
+package com.mango.service;
+
+import java.io.IOException;
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+import java.util.stream.Stream;
+
+public final class LocalImageChapterPageProvider implements ChapterPageProvider {
+    private final Path diretorioCapitulo;
+    private final Executor executor;
+
+    public LocalImageChapterPageProvider(final Path diretorioCapitulo) {
+        this(diretorioCapitulo, Executors.newVirtualThreadPerTaskExecutor());
+    }
+
+    public LocalImageChapterPageProvider(final Path diretorioCapitulo, final Executor executor) {
+        this.diretorioCapitulo = diretorioCapitulo;
+        this.executor = executor;
+    }
+
+    @Override
+    public CompletableFuture<List<URI>> listarUrlsPaginas(final String capituloId) {
+        return CompletableFuture.supplyAsync(() -> {
+            try (Stream<Path> stream = Files.list(diretorioCapitulo)) {
+                return stream
+                        .filter(Files::isRegularFile)
+                        .filter(LocalImageChapterPageProvider::ehImagem)
+                        .sorted(Comparator.comparing(path -> path.getFileName().toString()))
+                        .map(Path::toUri)
+                        .toList();
+            } catch (final IOException exception) {
+                throw new FalhaDownloadPaginaException("Não foi possível listar as páginas locais do capítulo.", exception);
+            }
+        }, executor);
+    }
+
+    @Override
+    public CompletableFuture<byte[]> baixarPagina(final URI paginaUri) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                return Files.readAllBytes(Path.of(paginaUri));
+            } catch (final IOException exception) {
+                throw new FalhaDownloadPaginaException("Não foi possível carregar a página local.", exception);
+            }
+        }, executor);
+    }
+
+    private static boolean ehImagem(final Path path) {
+        final String nome = path.getFileName().toString().toLowerCase(Locale.ROOT);
+        return nome.endsWith(".jpg")
+                || nome.endsWith(".jpeg")
+                || nome.endsWith(".png")
+                || nome.endsWith(".webp");
+    }
+}
diff --git a/src/main/java/com/mango/service/PageCacheService.java b/src/main/java/com/mango/service/PageCacheService.java
new file mode 100644
index 0000000..544ec85
--- /dev/null
+++ b/src/main/java/com/mango/service/PageCacheService.java
@@ -0,0 +1,235 @@
+package com.mango.service;
+
+import com.mango.model.SessaoLeitura;
+
+import java.io.IOException;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.Comparator;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+import java.util.stream.Stream;
+
+public final class PageCacheService {
+    public static final Duration CACHE_TTL = Duration.ofDays(7);
+    public static final long MAX_CACHE_BYTES = 1024L * 1024L * 1024L;
+
+    private final Path cacheRoot;
+    private final ChapterPageProvider pageProvider;
+    private final Executor ioExecutor;
+    private final Map<String, CompletableFuture<Path>> downloadsEmAndamento;
+
+    public PageCacheService(final Path cacheRoot, final ChapterPageProvider pageProvider) {
+        this(cacheRoot, pageProvider, Executors.newVirtualThreadPerTaskExecutor());
+    }
+
+    public PageCacheService(
+            final Path cacheRoot,
+            final ChapterPageProvider pageProvider,
+            final Executor ioExecutor
+    ) {
+        this.cacheRoot = Objects.requireNonNull(cacheRoot, "cacheRoot");
+        this.pageProvider = Objects.requireNonNull(pageProvider, "pageProvider");
+        this.ioExecutor = Objects.requireNonNull(ioExecutor, "ioExecutor");
+        this.downloadsEmAndamento = new ConcurrentHashMap<>();
+    }
+
+    public CompletableFuture<Path> carregarPagina(
+            final String capituloId,
+            final int paginaIndexZeroBased,
+            final URI paginaUri
+    ) {
+        final Path arquivoCache = arquivoCache(capituloId, paginaIndexZeroBased, paginaUri);
+        if (cacheValido(arquivoCache)) {
+            return CompletableFuture.completedFuture(arquivoCache);
+        }
+
+        final String chave = arquivoCache.toAbsolutePath().toString();
+        return downloadsEmAndamento.computeIfAbsent(chave, ignored ->
+                pageProvider.baixarPagina(paginaUri)
+                        .thenApplyAsync(bytes -> salvarNoCache(arquivoCache, bytes), ioExecutor)
+                        .thenApply(path -> {
+                            aplicarLimiteTamanhoCache();
+                            return path;
+                        })
+                        .whenComplete((path, error) -> downloadsEmAndamento.remove(chave))
+        );
+    }
+
+    public CompletableFuture<Path> recarregarPagina(
+            final String capituloId,
+            final int paginaIndexZeroBased,
+            final URI paginaUri
+    ) {
+        final Path arquivoCache = arquivoCache(capituloId, paginaIndexZeroBased, paginaUri);
+        try {
+            Files.deleteIfExists(arquivoCache);
+        } catch (final IOException exception) {
+            throw new FalhaDownloadPaginaException("Não foi possível remover a página antiga do cache.", exception);
+        }
+        return carregarPagina(capituloId, paginaIndexZeroBased, paginaUri);
+    }
+
+    public void preCarregarProximas(final SessaoLeitura sessao) {
+        final int paginaAtual = sessao.paginaAtualIndex();
+        final int ultimaPaginaParaPreload = Math.min(sessao.totalPaginas() - 1, paginaAtual + 2);
+
+        for (int index = paginaAtual + 1; index <= ultimaPaginaParaPreload; index++) {
+            carregarPagina(
+                    sessao.capitulo().id(),
+                    index,
+                    sessao.capitulo().paginaPorIndice(index)
+            );
+        }
+    }
+
+    public void limparExpirados() {
+        if (!Files.exists(cacheRoot)) {
+            return;
+        }
+
+        final Instant limite = Instant.now().minus(CACHE_TTL);
+        try (Stream<Path> stream = Files.walk(cacheRoot)) {
+            stream.filter(Files::isRegularFile)
+                    .filter(path -> foiModificadoAntesDe(path, limite))
+                    .forEach(this::deletarSilenciosamente);
+        } catch (final IOException exception) {
+            throw new FalhaDownloadPaginaException("Não foi possível limpar o cache de páginas expiradas.", exception);
+        }
+    }
+
+    private boolean cacheValido(final Path arquivoCache) {
+        if (!Files.exists(arquivoCache)) {
+            return false;
+        }
+
+        try {
+            final Instant modifiedAt = Files.getLastModifiedTime(arquivoCache).toInstant();
+            return modifiedAt.isAfter(Instant.now().minus(CACHE_TTL));
+        } catch (final IOException exception) {
+            return false;
+        }
+    }
+
+    private Path salvarNoCache(final Path arquivoCache, final byte[] bytes) {
+        try {
+            Files.createDirectories(arquivoCache.getParent());
+            Files.write(
+                    arquivoCache,
+                    bytes,
+                    StandardOpenOption.CREATE,
+                    StandardOpenOption.TRUNCATE_EXISTING,
+                    StandardOpenOption.WRITE
+            );
+            return arquivoCache;
+        } catch (final IOException exception) {
+            throw new FalhaDownloadPaginaException("Não foi possível salvar a página no cache local.", exception);
+        }
+    }
+
+    private Path arquivoCache(
+            final String capituloId,
+            final int paginaIndexZeroBased,
+            final URI paginaUri
+    ) {
+        final String capituloSeguro = capituloId.replaceAll("[^a-zA-Z0-9._-]", "_");
+        final String hash = hashCurto(capituloId + "|" + paginaIndexZeroBased + "|" + paginaUri);
+        final String extensao = extensaoDaUri(paginaUri);
+        return cacheRoot.resolve(capituloSeguro)
+                .resolve("%03d-%s%s".formatted(paginaIndexZeroBased + 1, hash, extensao));
+    }
+
+    private void aplicarLimiteTamanhoCache() {
+        if (!Files.exists(cacheRoot)) {
+            return;
+        }
+
+        final List<Path> arquivos;
+        try (Stream<Path> stream = Files.walk(cacheRoot)) {
+            arquivos = stream.filter(Files::isRegularFile)
+                    .sorted(Comparator.comparing(this::ultimoAcessoOuModificacao))
+                    .toList();
+        } catch (final IOException exception) {
+            throw new FalhaDownloadPaginaException("Não foi possível verificar o tamanho do cache local.", exception);
+        }
+
+        long totalBytes = arquivos.stream().mapToLong(this::tamanhoSeguro).sum();
+        for (final Path arquivo : arquivos) {
+            if (totalBytes <= MAX_CACHE_BYTES) {
+                return;
+            }
+            final long tamanho = tamanhoSeguro(arquivo);
+            deletarSilenciosamente(arquivo);
+            totalBytes -= tamanho;
+        }
+    }
+
+    private boolean foiModificadoAntesDe(final Path path, final Instant limite) {
+        try {
+            return Files.getLastModifiedTime(path).toInstant().isBefore(limite);
+        } catch (final IOException exception) {
+            return false;
+        }
+    }
+
+    private Instant ultimoAcessoOuModificacao(final Path path) {
+        try {
+            return Files.getLastModifiedTime(path).toInstant();
+        } catch (final IOException exception) {
+            return Instant.EPOCH;
+        }
+    }
+
+    private long tamanhoSeguro(final Path path) {
+        try {
+            return Files.size(path);
+        } catch (final IOException exception) {
+            return 0L;
+        }
+    }
+
+    private void deletarSilenciosamente(final Path path) {
+        try {
+            Files.deleteIfExists(path);
+        } catch (final IOException ignored) {
+            // A limpeza do cache é melhor esforço; falhas isoladas não devem interromper a leitura.
+        }
+    }
+
+    private static String hashCurto(final String valor) {
+        try {
+            final MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            final byte[] bytes = digest.digest(valor.getBytes(StandardCharsets.UTF_8));
+            return HexFormat.of().formatHex(bytes).substring(0, 16);
+        } catch (final NoSuchAlgorithmException exception) {
+            throw new IllegalStateException("SHA-256 indisponível.", exception);
+        }
+    }
+
+    private static String extensaoDaUri(final URI uri) {
+        final String path = uri.getPath() == null ? "" : uri.getPath().toLowerCase(Locale.ROOT);
+        final int dotIndex = path.lastIndexOf('.');
+        if (dotIndex < 0 || dotIndex == path.length() - 1) {
+            return ".img";
+        }
+        final String extensao = path.substring(dotIndex);
+        return switch (extensao) {
+            case ".jpg", ".jpeg", ".png", ".webp" -> extensao;
+            default -> ".img";
+        };
+    }
+}
